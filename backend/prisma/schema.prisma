generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model University {
  id                    String              @id @default(uuid())
  name                  String
  logo                  String?
  category              String              @default("UNIVERSITY")
  address               String?
  phone                 String?
  email                 String?
  website               String?
  integrationWebhookUrl String?
  integrationApiKey     String?
  sisIntegrationUrl     String?
  status                String              @default("ACTIVE")
  suspendedAt           DateTime?
  accessRevokedAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  reportSettings        Json?
  licenseType           String?
  integrationMode       String              @default("STANDALONE")
  integrationConfig     Json?
  lastSyncAt            DateTime?
  licenseRevoked        Boolean             @default(false)
  currentSemesterId     String?
  sessions              AttendanceSession[]
  auditLogs             AuditLog[]
  billingEvents         BillingEvent[]
  departments           Department[]
  faculties             Faculty[]
  hods                  Hod[]
  lecturers             Lecturer[]
  licenses              License[]
  programmes            Programme[]
  semesters             Semester[]
  students              Student[]
  units                 Unit[]
  admins                UniversityAdmin[]
}

model BillingEvent {
  id           String     @id @default(uuid())
  licenseId    String
  universityId String
  eventType    String
  amount       Float
  currency     String     @default("USD")
  description  String
  status       String     @default("COMPLETED")
  createdAt    DateTime   @default(now())
  license      License    @relation(fields: [licenseId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
}

model Faculty {
  id           String       @id @default(uuid())
  name         String
  universityId String
  deanId       String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  departments  Department[]
  dean         Lecturer?    @relation(fields: [deanId], references: [id])
  university   University   @relation(fields: [universityId], references: [id])
}

model Department {
  id           String           @id @default(uuid())
  name         String
  facultyId    String
  universityId String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  faculty      Faculty          @relation(fields: [facultyId], references: [id])
  university   University       @relation(fields: [universityId], references: [id])
  hods         Hod[]
  lecturers    Lecturer[]
  programmes   Programme[]
  Student      Student[]
  issues       TechnicalIssue[]
  units        Unit[]
}

model Programme {
  id           String     @id @default(uuid())
  name         String
  code         String?
  level        Int?
  duration     Int
  departmentId String
  universityId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  department   Department @relation(fields: [departmentId], references: [id])
  university   University @relation(fields: [universityId], references: [id])
  students     Student[]
  units        Unit[]
}

model StudyYear {
  id           String    @id @default(uuid())
  name         String
  description  String?
  universityId String?
  createdAt    DateTime  @default(now())
  students     Student[]
  units        Unit[]
}

model Semester {
  id           String     @id @default(uuid())
  name         String
  startDate    DateTime?
  endDate      DateTime?
  status       String     @default("INACTIVE")
  archived     Boolean    @default(false)
  archivedAt   DateTime?
  universityId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  university   University @relation(fields: [universityId], references: [id])
  students     Student[]
  units        Unit[]

  @@index([universityId, status, archived])
}

model Unit {
  id                     String                   @id @default(uuid())
  name                   String
  code                   String
  programId              String
  studyYearId            String
  semesterId             String
  departmentId           String
  universityId           String
  createdAt              DateTime                 @default(now())
  sessions               AttendanceSession[]
  LecturerUnitAssignment LecturerUnitAssignment[]
  department             Department               @relation(fields: [departmentId], references: [id])
  program                Programme                @relation(fields: [programId], references: [id])
  semester               Semester                 @relation(fields: [semesterId], references: [id])
  studyYear              StudyYear                @relation(fields: [studyYearId], references: [id])
  University             University               @relation(fields: [universityId], references: [id])
  lecturers              Lecturer[]               @relation("LecturerUnits")
  students               Student[]                @relation("StudentUnits")
}

model LecturerUnitAssignment {
  id         String   @id @default(uuid())
  lecturerId String
  unitId     String
  assignedAt DateTime @default(now())
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id])
  unit       Unit     @relation(fields: [unitId], references: [id])

  @@unique([lecturerId, unitId])
}

model Student {
  id              String             @id @default(uuid())
  regNo           String             @unique
  fullName        String
  phone           String?
  email           String?
  programId       String
  password        String
  studyYearId     String
  semesterId      String
  admissionYear   String
  departmentId    String
  universityId    String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  archived        Boolean            @default(false)
  archivedAt      DateTime?
  archiveUntil    DateTime?
  records         AttendanceRecord[]
  department      Department         @relation(fields: [departmentId], references: [id])
  program         Programme          @relation(fields: [programId], references: [id])
  semester        Semester           @relation(fields: [semesterId], references: [id])
  studyYear       StudyYear          @relation(fields: [studyYearId], references: [id])
  University      University         @relation(fields: [universityId], references: [id])
  registeredUnits Unit[]             @relation("StudentUnits")
}

model Lecturer {
  id               String                   @id @default(uuid())
  staffNumber      String                   @unique
  fullName         String
  email            String                   @unique
  phone            String?
  password         String
  departmentId     String
  universityId     String
  status           String                   @default("ACTIVE")
  lastLogin        DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  resetToken       String?
  resetTokenExpiry DateTime?
  corrections      AttendanceCorrection[]
  sessions         AttendanceSession[]
  deanOfFaculty    Faculty?
  department       Department               @relation(fields: [departmentId], references: [id])
  university       University               @relation(fields: [universityId], references: [id])
  assignments      LecturerUnitAssignment[]
  units            Unit[]                   @relation("LecturerUnits")
}

model Hod {
  id            String     @id @default(uuid())
  staffNumber   String
  fullName      String
  email         String     @unique
  phone         String?
  password      String?
  status        String     @default("ACTIVE")
  lastLogin     DateTime?
  plainPassword String?
  departmentId  String
  universityId  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  department    Department @relation(fields: [departmentId], references: [id])
  university    University @relation(fields: [universityId], references: [id])

  @@unique([universityId, staffNumber])
  @@unique([universityId, email])
}

model PlatformAdmin {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique
  password  String
  role      String    @default("SUPER_ADMIN")
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model AttendanceSession {
  id                  String             @id @default(uuid())
  sessionDate         DateTime           @default(now())
  lecturerId          String
  unitId              String
  archived            Boolean            @default(false)
  duration            Int                @default(15)
  endTime             DateTime?
  universityId        String
  departmentId        String
  radius              Int                @default(75)
  lecturerLatitude    Float?
  lecturerLongitude   Float?
  lecturerGpsAccuracy Float?
  gpsLocation         String?
  token               String             @unique @default(uuid())
  totalStudents       Int?
  status              String             @default("ACTIVE")
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  records             AttendanceRecord[]
  lecturer            Lecturer           @relation(fields: [lecturerId], references: [id])
  unit                Unit               @relation(fields: [unitId], references: [id])
  university          University         @relation(fields: [universityId], references: [id])
}

model AttendanceCorrection {
  id             String           @id @default(uuid())
  recordId       String
  lecturerId     String
  reason         String
  previousStatus String
  newStatus      String
  correctedAt    DateTime         @default(now())
  lecturer       Lecturer         @relation(fields: [lecturerId], references: [id])
  record         AttendanceRecord @relation(fields: [recordId], references: [id])
}

model AttendanceRecord {
  id                 String                 @id @default(uuid())
  sessionId          String
  studentId          String
  status             String
  browserFingerprint String?
  googleAccountId    String?
  distance           Float?
  createdAt          DateTime               @default(now())
  corrections        AttendanceCorrection[]
  session            AttendanceSession      @relation(fields: [sessionId], references: [id])
  student            Student                @relation(fields: [studentId], references: [id])
}

model AuditLog {
  id           String      @id @default(uuid())
  userType     String
  userId       String?
  activity     String
  description  String
  ipAddress    String?
  device       String?
  browser      String?
  timestamp    DateTime    @default(now())
  universityId String?
  university   University? @relation(fields: [universityId], references: [id])
}

model AcademicYear {
  id           String    @id @default(uuid())
  name         String
  startDate    DateTime?
  endDate      DateTime?
  universityId String
  status       String    @default("INACTIVE")
  archived     Boolean   @default(false)
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model License {
  id                String         @id @default(uuid())
  code              String         @unique
  universityId      String?
  type              String         @default("SUBSCRIPTION")
  status            String         @default("UNUSED")
  previousStatus    String?
  usedBy            String?
  startDate         DateTime?
  expiryDate        DateTime?
  isTrial           Boolean        @default(false)
  trialEndsAt       DateTime?
  revokedAt         DateTime?
  pdfPassword       String?
  gracePeriodEndsAt DateTime?
  accessBlocked     Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  billingHistory    BillingEvent[]
  university        University?    @relation(fields: [universityId], references: [id])
}

model UniversityAdmin {
  id              String     @id @default(uuid())
  staffNumber     String?    @unique
  fullName        String
  email           String     @unique
  phone           String?
  password        String
  avatar          String?
  category        String     @default("UNIVERSITY")
  licenseType     String     @default("SUBSCRIPTION")
  role            String     @default("UNIVERSITY_ADMIN")
  universityId    String
  status          String     @default("ACTIVE")
  lastLogin       DateTime?
  licenseRevoked  Boolean    @default(false)
  accessBlockedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  university      University @relation(fields: [universityId], references: [id])
}

model Notification {
  id           String   @id @default(uuid())
  userType     String
  userId       String
  universityId String?
  category     String   @default("GENERAL")
  title        String
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model TechnicalIssue {
  id           String      @id @default(uuid())
  universityId String
  departmentId String?
  title        String
  description  String
  severity     String      @default("MEDIUM")
  status       String      @default("OPEN")
  reportedBy   String?
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?
  department   Department? @relation(fields: [departmentId], references: [id])
}

model IntegrationSetting {
  id           String    @id @default(uuid())
  universityId String    @unique
  type         String
  config       String?
  isActive     Boolean   @default(false)
  lastSync     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
